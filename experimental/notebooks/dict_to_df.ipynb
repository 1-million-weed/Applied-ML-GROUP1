    "import os\n",
    "import pandas as pd\n",
    "csv = pd.read_csv('results_with_elo_with_championships.csv')\n",
    "for round in csv['RoundNumber'].unique():\n",
    "    round_csv = csv[csv['RoundNumber'] == round]\n",
    "    print(round_csv['BroadcastName'], round_csv['DriverWinsCount'])"
   ]
